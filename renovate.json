{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "forkProcessing": "enabled",
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Keep Cargo manifest requirements semver-ranged; Cargo.lock provides reproducibility",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  }
}
